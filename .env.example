# locos — environment variables
# Copy this file to .env.local and fill in real values for local development.
# env.ts Zod-validates every variable at boot; missing/invalid vars crash the
# process with a clear message before any work begins (Story 1.0 AC #3).

NODE_ENV=development
LOG_LEVEL=info

# Postgres 17 (see docker-compose.yml). The default matches docker-compose.
DATABASE_URL=postgresql://locos:locos_dev_password@localhost:5432/locos

# Clerk — phone+OTP auth. Create a dev app at https://dashboard.clerk.com
# Enable SMS providers (eSMS.vn primary + Twilio Verify fallback) in Clerk config.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# fal.ai — FASHN model-on-product image generation. Get a key at https://fal.ai
FAL_KEY=replace_me

# Google AI Studio — Gemini text generation. https://aistudio.google.com
GEMINI_API_KEY=replace_me

# Facebook Graph API. Create a dev app at https://developers.facebook.com
# Required permission: pages_manage_posts (Meta app review gate — see PRD §8 risks).
FACEBOOK_APP_ID=replace_me
FACEBOOK_APP_SECRET=replace_me

# AD-8 token envelope key — libsodium secretbox requires exactly 32 bytes.
# Generate locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit a real value. NEVER share between environments.
LOCOS_HOST_SECRET=replace_me_with_32_byte_base64_encoded_secret

# Public app URL (used for OAuth redirect URIs etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
